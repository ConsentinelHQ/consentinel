# Outreach pipeline. Copy to .env.outreach (gitignored). Keep prod secrets out of this file.

# Google OAuth (Desktop client, consent screen "Internal"). Get the refresh token with:
#   pnpm --filter @consentinel/scanner outreach auth
OUTREACH_GOOGLE_CLIENT_ID=
OUTREACH_GOOGLE_CLIENT_SECRET=
OUTREACH_GOOGLE_REFRESH_TOKEN=

# Send-as address on the outreach domain, configured in Gmail settings
OUTREACH_FROM="Charlie Buckley <charlie@getconsentinel.com>"

# Google Sheet ID (from its URL) and tab name
OUTREACH_SHEET_ID=
OUTREACH_SHEET_TAB=Prospects

# Required to send (CAN-SPAM). A PO box or virtual mailbox works.
OUTREACH_POSTAL_ADDRESS=

# Warmup: 5/day for 2 weeks, then 10
OUTREACH_DAILY_CAP=5
# GPC-only sites need this many ad vendors firing to be worth a lookup (sheet tier 2)
OUTREACH_MIN_GPC_VENDORS=8

# Contact lookup: Anymail first (charges only on a valid hit), Hunter fallback
ANYMAIL_API_KEY=
HUNTER_API_KEY=
