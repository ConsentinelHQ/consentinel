# Copy to .env. Never commit real values.

# Direct connection - migrations, scripts, and the scanner worker.
DATABASE_URL=postgres://user:pass@localhost:5432/consentinel
# Pooled (PgBouncer) - Next.js route handlers.
DATABASE_URL_POOLED=

REDIS_URL=redis://127.0.0.1:6379

# Worker tuning
SCAN_CONCURRENCY=2
SCAN_TIMEOUT_MS=90000
SCAN_MAX_ATTEMPTS=3
# Local fixtures only. MUST stay false in production - it disables the SSRF guard.
ALLOW_PRIVATE_SCAN_TARGETS=false

SENTRY_DSN=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
RESEND_API_KEY=
