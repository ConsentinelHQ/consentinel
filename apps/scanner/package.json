{
  "name": "@consentinel/scanner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx test/signatures.test.ts && tsx test/engine.test.ts && tsx test/worker.test.ts",
    "scan": "tsx src/cli.ts",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@consentinel/shared": "workspace:*",
    "playwright": "1.56.0",
    "@consentinel/db": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "zod": "^3.24.1",
    "@consentinel/queue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
