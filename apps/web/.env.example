# apps/web reads these at runtime. Set them in Vercel project settings.
DATABASE_URL=
DATABASE_URL_POOLED=
REDIS_URL=
# Local fixture scanning only. MUST be unset in production - it disables the SSRF guard.
ALLOW_PRIVATE_SCAN_TARGETS=false

# Report delivery. Without RESEND_API_KEY the report still unlocks in-page.
RESEND_API_KEY=
REPORT_FROM_EMAIL=Consentinel <reports@yourdomain.com>

# Bot protection. Without a secret, verification is skipped (local dev only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Encrypts stored Jira API tokens. openssl rand -base64 32. Same value on the worker.
INTEGRATION_KEY=

# Stripe price ids (price_...). A plan can't be bought until its price is set.
STRIPE_PRICE_MONITORING=
STRIPE_PRICE_MONITORING_ANNUAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_ANNUAL=
