# ---------------------------------------------------------------------------
# Consentinel — root .gitignore (Turborepo monorepo)
# ---------------------------------------------------------------------------

# Dependencies (matches node_modules at any depth in the monorepo)
node_modules/
.pnp
.pnp.js

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---- Secrets — NEVER commit (we hold ourselves to the standard we sell) ----
.env
.env.*
*.pem
*.key
# ...but DO commit the template so contributors know what to set:
!.env.example

# Turborepo
.turbo/

# TypeScript build artifacts
dist/
build/
*.tsbuildinfo

# Next.js (apps/web)
.next/
out/
.vercel/
next-env.d.ts

# Playwright (apps/scanner)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Scanner runtime output (raw captures / findings — data, not source)
**/out/
*.jsonl

# Test coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
*.local

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json